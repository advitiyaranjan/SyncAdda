{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "regions": ["bom1"],
  "functions": { "api/socket.js": { "maxDuration": 300 } },
  "crons": [{ "path": "/api/cleanup-uploads", "schedule": "0 3 * * *" }],
  "rewrites": [{ "source": "/room/:code", "destination": "/index.html" }]
}
