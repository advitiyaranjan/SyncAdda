PORT=3001
# Vercel deployment uses Redis for rooms shared across WebSocket function instances.
# The Vercel Redis integration supplies KV_URL automatically. For a separate Redis server:
# REDIS_URL=rediss://user:password@host:6379
# Enables sharing videos/songs from your device (Vercel sets this when a Blob store is connected).
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...
# Public origin of your deployed app; same-origin requests only when unset.
# APP_ORIGIN=https://syncadda.example.com
# Add a TURN service for calls across restrictive networks. Never commit credentials.
# ICE_SERVERS_JSON=[{"urls":"stun:stun.l.google.com:19302"},{"urls":"turn:your-host:3478","username":"your-user","credential":"your-password"}]
